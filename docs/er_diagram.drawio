<mxfile host="65bd71144e">
    <diagram id="1DdCFmjDfUkbM29-_ULm" name="Page-1">
        <mxGraphModel dx="2100" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ========================================\n    %% BRONZE LAYER (Raw)\n    %% ========================================\n\n    raw_eia_energy_data {\n        BIGSERIAL id PK\n        VARCHAR source\n        TIMESTAMP ingestion_timestamp\n        VARCHAR series_id\n        VARCHAR period\n        NUMERIC value\n        VARCHAR units\n        VARCHAR location\n        VARCHAR location_type\n        VARCHAR energy_source\n        VARCHAR sector\n        JSONB raw_json\n    }\n\n    raw_enrichment_data {\n        BIGSERIAL id PK\n        VARCHAR source\n        TIMESTAMP ingestion_timestamp\n        VARCHAR period\n        VARCHAR location\n        NUMERIC temperature_avg\n        VARCHAR temperature_unit\n        BIGINT population\n        NUMERIC gdp_per_capita\n        NUMERIC industrial_activity_index\n        JSONB raw_json\n    }\n\n    %% ========================================\n    %% SILVER LAYER (Staging)\n    %% ========================================\n\n    staging_stg_energy_generation {\n        BIGSERIAL generation_id PK\n        BIGINT source_id FK\n        DATE period_date\n        VARCHAR period_type\n        VARCHAR location\n        VARCHAR location_type\n        VARCHAR energy_source\n        NUMERIC generation_mwh\n        TIMESTAMP created_at\n    }\n\n    staging_stg_energy_consumption {\n        BIGSERIAL consumption_id PK\n        BIGINT source_id FK\n        DATE period_date\n        VARCHAR period_type\n        VARCHAR location\n        VARCHAR sector\n        NUMERIC consumption_mwh\n        TIMESTAMP created_at\n    }\n\n    staging_stg_enrichment {\n        BIGSERIAL enrichment_id PK\n        BIGINT source_id FK\n        DATE period_date\n        VARCHAR location\n        NUMERIC temperature_fahrenheit\n        INTEGER population\n        NUMERIC gdp_per_capita_usd\n        NUMERIC industrial_activity_index\n        TIMESTAMP created_at\n    }\n\n    %% ========================================\n    %% SILVER LAYER (Intermediate)\n    %% ========================================\n\n    intermediate_int_energy_combined {\n        BIGSERIAL combined_id PK\n        DATE period_date\n        VARCHAR location\n        NUMERIC total_generation_mwh\n        NUMERIC renewable_generation_mwh\n        NUMERIC fossil_generation_mwh\n        NUMERIC nuclear_generation_mwh\n        NUMERIC total_consumption_mwh\n        NUMERIC residential_consumption_mwh\n        NUMERIC commercial_consumption_mwh\n        NUMERIC industrial_consumption_mwh\n        NUMERIC temperature_fahrenheit\n        INTEGER population\n        NUMERIC gdp_per_capita_usd\n        NUMERIC industrial_activity_index\n        TIMESTAMP created_at\n    }\n\n    %% ========================================\n    %% GOLD LAYER (Marts - Dimensional Model)\n    %% ========================================\n\n    marts_dim_time {\n        INTEGER time_key PK\n        DATE date UK\n        INTEGER year\n        INTEGER quarter\n        INTEGER month\n        VARCHAR month_name\n        INTEGER day_of_month\n        INTEGER day_of_week\n        VARCHAR day_name\n        INTEGER week_of_year\n        BOOLEAN is_weekend\n        BOOLEAN is_holiday\n        TIMESTAMP created_at\n    }\n\n    marts_dim_location {\n        SERIAL location_key PK\n        VARCHAR location_code UK\n        VARCHAR location_name\n        VARCHAR location_type\n        VARCHAR region\n        VARCHAR timezone\n        NUMERIC latitude\n        NUMERIC longitude\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    marts_dim_energy_source {\n        SERIAL energy_source_key PK\n        VARCHAR energy_source_code UK\n        VARCHAR energy_source_name\n        VARCHAR category\n        BOOLEAN is_renewable\n        NUMERIC carbon_intensity_kg_per_mwh\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    marts_fct_energy_metrics {\n        BIGSERIAL metric_key PK\n        INTEGER time_key FK\n        INTEGER location_key FK\n        NUMERIC coal_generation_mwh\n        NUMERIC natural_gas_generation_mwh\n        NUMERIC nuclear_generation_mwh\n        NUMERIC solar_generation_mwh\n        NUMERIC wind_generation_mwh\n        NUMERIC hydro_generation_mwh\n        NUMERIC other_generation_mwh\n        NUMERIC total_generation_mwh\n        NUMERIC renewable_generation_mwh\n        NUMERIC fossil_generation_mwh\n        NUMERIC residential_consumption_mwh\n        NUMERIC commercial_consumption_mwh\n        NUMERIC industrial_consumption_mwh\n        NUMERIC transportation_consumption_mwh\n        NUMERIC total_consumption_mwh\n        NUMERIC renewable_percentage\n        NUMERIC net_generation_mwh\n        NUMERIC avg_temperature_fahrenheit\n        INTEGER population\n        NUMERIC gdp_per_capita_usd\n        NUMERIC industrial_activity_index\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    %% ========================================\n    %% AUDIT LAYER\n    %% ========================================\n\n    audit_pipeline_runs {\n        BIGSERIAL run_id PK\n        VARCHAR pipeline_name\n        VARCHAR run_status\n        TIMESTAMP start_time\n        TIMESTAMP end_time\n        INTEGER duration_seconds\n        INTEGER rows_processed\n        INTEGER rows_inserted\n        INTEGER rows_updated\n        INTEGER rows_failed\n        TEXT error_message\n        JSONB metadata\n    }\n\n    audit_data_quality_checks {\n        BIGSERIAL check_id PK\n        VARCHAR check_name\n        VARCHAR table_schema\n        VARCHAR table_name\n        VARCHAR check_type\n        VARCHAR check_result\n        INTEGER rows_checked\n        INTEGER rows_failed\n        NUMERIC failure_percentage\n        TIMESTAMP check_timestamp\n        JSONB details\n    }\n\n    %% ========================================\n    %% RELATIONSHIPS\n    %% ========================================\n\n    %% Bronze -&gt; Staging relationships\n    raw_eia_energy_data ||--o{ staging_stg_energy_generation : \&quot;source_id\&quot;\n    raw_eia_energy_data ||--o{ staging_stg_energy_consumption : \&quot;source_id\&quot;\n    raw_enrichment_data ||--o{ staging_stg_enrichment : \&quot;source_id\&quot;\n\n    %% Staging -&gt; Intermediate (logical relationships via period_date + location)\n    staging_stg_energy_generation ||--o{ intermediate_int_energy_combined : \&quot;aggregated by period+location\&quot;\n    staging_stg_energy_consumption ||--o{ intermediate_int_energy_combined : \&quot;aggregated by period+location\&quot;\n    staging_stg_enrichment ||--o{ intermediate_int_energy_combined : \&quot;joined by period+location\&quot;\n\n    %% Marts dimension relationships\n    marts_dim_time ||--o{ marts_fct_energy_metrics : \&quot;time_key\&quot;\n    marts_dim_location ||--o{ marts_fct_energy_metrics : \&quot;location_key\&quot;\n&quot;&#xa;}" id="2">
